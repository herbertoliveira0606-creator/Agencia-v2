  document.getElementById('cm-logo-preview').innerHTML = `<img src="${S.cmLogo}" style="max-height:70px;max-width:100%;border-radius:6px"><div style="font-size:.65rem;color:var(--dim);margin-top:6px">Toque para trocar</div>`;
}

