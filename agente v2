async function genContent(type) {
  const c = getC();
  const sys = `Você é especialista em marketing digital e produção de conteúdo. Responda sempre em português brasileiro. Seja direto, criativo e impactante. ${ctx(c)}`;
  let prompt = '';

  if (type === 'copy') {
    const topic = document.getElementById('cp-topic').value.trim();
    if (!topic) { alert('Informe o tema do post!'); return; }
    const tp = document.getElementById('cp-type').value;
    const pl = document.getElementById('cp-plat').value;
    const gl = document.getElementById('cp-goal').value;
    prompt = `Crie um(a) ${tp} para ${pl} sobre: "${topic}". Objetivo: ${gl}. Tom: ${c.tone}. Inclua gancho forte, desenvolvimento e CTA. Formate bem com emojis quando adequado.`;

  } else if (type === 'rot') {
    const topic = document.getElementById('rot-topic').value.trim();
    if (!topic) { alert('Informe o tema do vídeo!'); return; }
