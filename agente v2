      <button onclick="navigator.clipboard.writeText('${a.text.replace(/'/g,"\\'")}').then(()=>alert('Copiado!'))" style="margin-top:6px;background:none;border:none;color:var(--dim);font-size:.68rem;cursor:pointer;font-family:'Space Grotesk',sans-serif">◎ Copiar</button>
