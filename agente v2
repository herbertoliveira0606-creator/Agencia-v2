async function genBatch() {
  const concept = document.getElementById('bt-concept').value.trim();
  const qty = parseInt(document.getElementById('bt-qty').value);
  const vary = document.getElementById('bt-vary').value;
  if (!concept) { alert('Descreva o conceito base!'); return; }
  setBtn('btn-bt', true);
  const out = document.getElementById('bt-out');
  out.style.display='block';
  out.innerHTML='<div class="typing"><span></span><span></span><span></span></div>';
  const c = getC();
  const vMap = { style:'estilos visuais completamente diferentes', color:'paletas de cores diferentes', layout:'composições e layouts diferentes', mood:'moods/emoções diferentes', all:'variações máximas de estilo, cor, composição e mood' };
  try {
    const raw = await claude(
      `Gere ${qty} prompts em inglês para artes de ${document.getElementById('ds-res').value.split('|')[0]} para ${c.name} (${c.niche}). Conceito: "${concept}". Variar: ${vMap[vary]}. Máx 80 palavras cada. Responda APENAS JSON: {"prompts":["...","..."]}`,
      'Especialista em prompts para IA de imagem. Responda APENAS JSON válido, sem markdown.'
    );
    const parsed = JSON.parse(raw.replace(/```json|```/g,'').trim());
    const prompts = parsed.prompts || [];
    window._batchPrompts = prompts;
    out.innerHTML = `<div style="font-size:.72rem;color:var(--dim);margin-bottom:10px">${prompts.length} prompts gerados</div>
      ${prompts.map((p,i)=>`<div style="display:flex;gap:8px;padding:9px;background:var(--s2);border:1px solid var(--border);border-radius:7px;margin-bottom:6px;font-size:.75rem;line-height:1.5">
        <span style="font-family:'Space Mono',monospace;font-weight:700;color:var(--mg);min-width:20px;font-size:.72rem">${String(i+1).padStart(2,'0')}</span>
        <div style="flex:1">${p}</div>
        <button onclick="navigator.clipboard.writeText(this.previousElementSibling.textContent)" style="background:none;border:none;color:var(--dim);cursor:pointer;font-size:.85rem;flex-shrink:0">◎</button>
      </div>`).join('')}
      <div class="row" style="margin-top:10px">
        <button class="btn btn-p btn-sm" onclick="batchToFP()">⚡ Gerar no Freepik</button>
        <button class="btn btn-g btn-sm" onclick="navigator.clipboard.writeText((window._batchPrompts||[]).join('\\n\\n---\\n\\n')).then(()=>alert('Copiado!'))">◎ Copiar todos</button>
      </div>`;
  } catch(e) { out.innerHTML=`<div style="color:var(--mg2);font-size:.78rem">Erro: ${e.message}</div>`; }
  finally { setBtn('btn-bt', false); }
}

async function batchToFP() {
  const key = getFk(); if (!key) { alert('Configure sua chave Freepik!'); return; }
  const prompts = window._batchPrompts; if (!prompts?.length) return;
  const limit = Math.min(prompts.length, 5);
  if (!confirm(`Gerar ${limit} artes no Freepik (usa créditos)?`)) return;
  for(let i=0;i<limit;i++) {
    try {
      const d = await fpReq('/v1/ai/mystic',{prompt:prompts[i],resolution:'2k',num_images:1});
      const tid = d?.data?.task_id;
      if(tid){ const r = await pollFP('/v1/ai/mystic',tid,()=>{}); addToGallery(getUrls(r),prompts[i]); }
    } catch(e){}
  }
}

// Motion
async function genMotion() {
  const prompt = document.getElementById('mt-prompt').value.trim();
  if (!prompt) { alert('Descreva o vídeo!'); return; }
  const key = getFk();
  if (!key) { showMtFallback(prompt,''); return; }
  setBtn('btn-mt', true);
  const out = document.getElementById('mt-out');
  const modelMap = {'kling-v2':'/v1/ai/video/kling-v2','kling-v1-5':'/v1/ai/video/kling-v1-5','hailuo-t2v':'/v1/ai/video/hailuo-t2v','runway-gen4':'/v1/ai/video/runway'};
  const ep = modelMap[document.getElementById('mt-model').value] || '/v1/ai/video/kling-v2';
  out.innerHTML = '<div class="tsb"><div class="sp"></div><span style="font-size:.75rem">Enviando requisição...</span></div>';
  try {
    const body = {prompt,duration:parseInt(document.getElementById('mt-dur').value),aspect_ratio:document.getElementById('mt-ratio').value};
    const ref = document.getElementById('mt-ref').value.trim(); if(ref) body.image_url=ref;
    const d = await fpReq(ep, body);
    const tid = d?.data?.task_id || d?.task_id;
    if (!tid) throw new Error('Sem task_id');
    const result = await pollFP(ep, tid, (st,p)=>{
      out.innerHTML=`<div class="tsb"><div class="sp"></div><div style="flex:1"><div style="font-size:.75rem">${st} — ${p}%</div><div class="prog-bar"><div class="prog-fill" style="width:${p}%"></div></div></div></div>`;
    });
    const vUrl = result?.data?.generated?.[0] || result?.data?.result?.url;
    if (vUrl) {
      out.innerHTML=`<div style="background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:14px;display:flex;gap:12px;align-items:flex-start">
        <video src="${vUrl}" controls loop style="width:130px;border-radius:6px;flex-shrink:0"></video>
        <div><div style="font-family:'Space Mono',monospace;font-size:.72rem;font-weight:700;color:var(--mg);letter-spacing:.04em;margin-bottom:6px">VÍDEO GERADO</div>
        <div style="font-size:.72rem;color:var(--dim);margin-bottom:10px">${document.getElementById('mt-model').value} · ${document.getElementById('mt-dur').value}s</div>
        <div class="row"><a href="${vUrl}" download="video.mp4" class="btn btn-p btn-sm" style="text-decoration:none">⬇ MP4</a>
        <button onclick="navigator.clipboard.writeText('${vUrl}')" class="btn btn-g btn-sm">◎ URL</button></div></div>
      </div>`;
    }
  } catch(e) { showMtFallback(prompt, e.message==='CORS_BLOCKED'?'':e.message); }
  finally { setBtn('btn-mt', false); }
}

function showMtFallback(prompt, err) {
  const out = document.getElementById('mt-out');
  out.innerHTML=`<div style="font-size:.8rem;line-height:1.7">
    ${err?`<div style="color:var(--mg2);margin-bottom:8px">⚠ ${err}</div>`:'<div style="color:var(--mg2);font-weight:600;margin-bottom:8px">⚠ Safari bloqueou a conexão (CORS)</div>'}
    <a href="https://www.freepik.com/ai/video-generator" target="_blank" style="display:flex;align-items:center;gap:9px;padding:11px;background:var(--mgs);border:1px solid rgba(232,0,111,.2);border-radius:8px;text-decoration:none;color:var(--text);margin-bottom:8px">
      <span>◻</span><div><div style="font-size:.8rem;font-weight:500">Gerar no Freepik.com</div><div style="font-size:.68rem;color:var(--dim)">Kling, Runway, Hailuo disponíveis</div></div>
    </a>
    <div onclick="navigator.clipboard.writeText(this.querySelector('span').textContent).then(()=>this.style.borderColor='#10b981')" style="padding:9px;background:var(--s2);border:1px solid var(--border);border-radius:7px;cursor:pointer">
      <div style="font-size:.65rem;color:var(--dim);margin-bottom:4px">Seu prompt (toque para copiar):</div>
      <span style="font-size:.75rem">${prompt}</span>
    </div>
  </div>`;
}

// Upscale
async function runUp() {
  const url = document.getElementById('up-url').value.trim();
  if (!url) { alert('Cole a URL da imagem!'); return; }
  const key = getFk(); if (!key) { alert('Configure sua chave Freepik!'); return; }
  setBtn('btn-up', true);
  const out = document.getElementById('up-out');
  out.innerHTML='<div class="tsb"><div class="sp"></div><span style="font-size:.75rem">Iniciando Magnific Upscaler...</span></div>';
  try {
    const body={image_url:url,scale_factor:parseInt(document.getElementById('up-fac').value),style_type:document.getElementById('up-sty').value};
    const up = document.getElementById('up-prompt').value.trim(); if(up) body.prompt=up;
    const d = await fpReq('/v1/ai/image-upscaler', body);
    const tid = d?.data?.task_id || d?.task_id;
    if (!tid) throw new Error('Sem task_id');
    const r = await pollFP('/v1/ai/image-upscaler', tid, (st,p)=>{
      out.innerHTML=`<div class="tsb"><div class="sp"></div><div style="flex:1"><div style="font-size:.75rem">Magnific: ${st} — ${p}%</div><div class="prog-bar"><div class="prog-fill" style="width:${p}%"></div></div></div></div>`;
    });
    const urls = getUrls(r);
    if (urls.length) { addToGallery(urls, 'Upscale Magnific'); out.innerHTML='<div style="color:#10b981;font-size:.78rem">✓ Upscale concluído! Salvo na galeria.</div>'; }
  } catch(e) {
    out.innerHTML=`<div style="font-size:.78rem;color:var(--mg2)">Erro: ${e.message === 'CORS_BLOCKED' ? 'Safari bloqueou (CORS). Tente via ' : e.message} <a href="https://www.freepik.com/ai/image-upscaler" target="_blank" style="color:var(--mg)">freepik.com →</a></div>`;
  } finally { setBtn('btn-up', false); }
}

// Stock
async function searchStock() {
  const q = document.getElementById('sk-q').value.trim(); if(!q){alert('Digite o que buscar!');return;}
  const key = getFk();
  if (!key) { document.getElementById('sk-out').innerHTML=`<div style="font-size:.78rem;color:var(--dim)">Configure sua chave Freepik. <a href="https://www.freepik.com/search?query=${encodeURIComponent(q)}" target="_blank" style="color:var(--mg)">Abrir no Freepik →</a></div>`; return; }
  setBtn('btn-sk', true);
  const out = document.getElementById('sk-out');
  out.innerHTML='<div class="typing"><span></span><span></span><span></span></div>';
  try {
    const type = document.getElementById('sk-type').value;
    const r = await fetch(`https://api.freepik.com/v1/resources?locale=pt_BR&page=1&limit=12&order=latest&term=${encodeURIComponent(q)}&filters[content_type][${type}]=1`,{headers:{'x-freepik-api-key':key,'Accept':'application/json'}});
    const d = await r.json();
    const items = d?.data || [];
    if (!items.length) { out.innerHTML=`<div style="font-size:.78rem;color:var(--dim)">Sem resultados. <a href="https://www.freepik.com/search?query=${encodeURIComponent(q)}" target="_blank" style="color:var(--mg)">Ver no Freepik →</a></div>`; return; }
    out.innerHTML=`<div class="stg">${items.map(it=>{
      const th=it?.thumbnails?.[0]?.url||'';
      const url=it?.url||'#';
      return `<div class="sti" onclick="window.open('${url}','_blank')">${th?`<img src="${th}" loading="lazy">`:'<div style="aspect-ratio:1;background:var(--s3);display:flex;align-items:center;justify-content:center;opacity:.3">◻</div>'}<div class="sti-m">${(it.title||'').slice(0,25)}...</div></div>`;
    }).join('')}</div>`;
  } catch(e) { out.innerHTML=`<div style="font-size:.78rem;color:var(--dim)"><a href="https://www.freepik.com/search?query=${encodeURIComponent(q)}" target="_blank" style="color:var(--mg)">Abrir no Freepik →</a></div>`; }
  finally { setBtn('btn-sk', false); }
}

function showDsFallback(outId, prompt, isCors) {
  const el = document.getElementById(outId); if(!el) return;
  el.innerHTML=`<div style="font-size:.8rem;line-height:1.7">
    ${isCors?'<div style="color:var(--mg2);font-weight:600;margin-bottom:8px">⚠ Safari bloqueou (CORS)</div>':'<div style="color:var(--mg2);margin-bottom:8px">⚠ Chave Freepik não configurada</div>'}
    <a href="https://www.freepik.com/ai/image-generator?prompt=${encodeURIComponent(prompt)}" target="_blank" style="display:flex;align-items:center;gap:9px;padding:11px;background:var(--mgs);border:1px solid rgba(232,0,111,.2);border-radius:8px;text-decoration:none;color:var(--text);margin-bottom:8px">
      <span>◻</span><div><div style="font-size:.8rem;font-weight:500">Gerar no Freepik.com</div><div style="font-size:.68rem;color:var(--dim)">Abre com seu prompt pré-preenchido</div></div>
    </a>
    <div onclick="navigator.clipboard.writeText(this.querySelector('b').textContent).then(()=>{this.style.borderColor='#10b981'})" style="padding:9px;background:var(--s2);border:1px solid var(--border);border-radius:7px;cursor:pointer">
      <div style="font-size:.65rem;color:var(--dim);margin-bottom:3px">Prompt (toque para copiar):</div>
      <b style="font-weight:400;font-size:.75rem">${prompt}</b>
    </div>
  </div>`;
}

