  el.innerHTML = S.cmPalette.map((c,i)=>`<div class="pal-chip" style="background:${c}" title="${c}" onclick="rmPaletteColor(${i})"></div>`).join('');
}
function rmPaletteColor(i) { S.cmPalette.splice(i,1); renderPalette(); }

async function handleAssets(ev) {
  const files = Array.from(ev.target.files);
  for (const f of files) {
    try { const d = await fileToDataUrl(f, 500); S.cmAssets.push(d); } catch(e){}
  }
  renderAssetsPreview();
}
function renderAssetsPreview() {
  const el = document.getElementById('cm-assets-preview');
  el.innerHTML = S.cmAssets.map((a,i)=>`<img src="${a}" class="asset-thumb" onclick="rmAsset(${i})" title="Toque para remover">`).join('');
