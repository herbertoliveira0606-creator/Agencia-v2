}

// ════════════════════════════════════
// CLAUDE API
// ════════════════════════════════════
async function claude(prompt, sys) {
  const res = await fetch('https://api.anthropic.com/v1/messages', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ model:'claude-sonnet-4-20250514', max_tokens:1000, system: sys, messages:[{role:'user',content:prompt}] }),
  });
  const d = await res.json();
  if (d.error) throw new Error(d.error.message || 'Erro na API Claude');
  return d.content?.map(b=>b.text||'').join('') || '';
}

function ctx(c) {
  let base = `Cliente: ${c.name} | Nicho: ${c.niche} | Tom: ${c.tone} | Público: ${c.audience||'Geral'} | Brief: ${c.notes||'N/A'}`;
  if (c.palette && c.palette.length) base += ` | Paleta de cores da marca: ${c.palette.join(', ')}`;
  if (c.fontTitle) base += ` | Fonte títulos: ${c.fontTitle}`;
  if (c.fontBody) base += ` | Fonte textos: ${c.fontBody}`;
  return base;
}

