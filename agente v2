async function fpReq(endpoint, body) {
  const key = getFk();
  if (!key) throw new Error('NO_KEY');
  const url = `https://api.freepik.com${endpoint}`;
  const opts = { method:'POST', headers:{'Content-Type':'application/json','x-freepik-api-key':key}, body:JSON.stringify(body) };
  // Try direct
  try {
    const r = await fetch(url, opts);
    if (r.status===401) throw new Error('Chave Freepik inválida (401).');
    if (r.status===402) throw new Error('Sem créditos Freepik (402).');
    if (r.status===429) throw new Error('Limite de requisições atingido.');
    if (r.ok) return r.json();
  } catch(e) { if(e.message.includes('401')||e.message.includes('402')||e.message.includes('Limite')) throw e; }
  // Try proxies
  for (const px of PROXIES) {
    try {
      const r = await fetch(px(url), { method:'POST', headers:{'Content-Type':'application/json','x-freepik-api-key':key}, body:JSON.stringify(body) });
      if (r.ok) return r.json();
    } catch(e) {}
  }
  throw new Error('CORS_BLOCKED');
}

async function fpGet(endpoint) {
  const key = getFk();
  const url = `https://api.freepik.com${endpoint}`;
  try { const r = await fetch(url,{headers:{'x-freepik-api-key':key}}); if(r.ok) return r.json(); } catch(e){}
  for (const px of PROXIES) {
    try { const r = await fetch(px(url),{headers:{'x-freepik-api-key':key}}); if(r.ok) return r.json(); } catch(e){}
  }
  throw new Error('CORS_BLOCKED');
}

async function pollFP(endpoint, taskId, onUpd) {
  for(let i=0;i<60;i++) {
    await new Promise(r=>setTimeout(r,4000));
    try {
      const d = await fpGet(`${endpoint}/${taskId}`);
      const st = d?.data?.status || d?.status;
      onUpd(st, Math.min(10+i*2,95));
      if(st==='COMPLETED') return d;
      if(st==='FAILED') throw new Error('Geração falhou no servidor.');
    } catch(e) { if(e.message.includes('falhou')) throw e; }
  }
  throw new Error('Timeout');
}

function getUrls(d) {
  const g = d?.data?.generated || d?.generated || [];
  if(Array.isArray(g)&&g.length) return g.map(x=>typeof x==='string'?x:x?.url||x?.image_url).filter(Boolean);
  const s = d?.data?.result?.url || d?.data?.image?.url;
  return s ? [s] : [];
}

