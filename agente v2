<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>ContentOS</title>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #080808;
  --s1: #0f0f0f;
  --s2: #161616;
  --s3: #1e1e1e;
  --border: #242424;
  --border2: #2e2e2e;
  --mg: #e8006f;
  --mg2: #ff2d8a;
  --mg3: #ff80bb;
  --mgs: rgba(232,0,111,.08);
  --mgs2: rgba(232,0,111,.15);
  --text: #f0f0f0;
  --sub: #888;
  --dim: #555;
  --white: #fff;
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{font-family:'Space Grotesk',sans-serif;background:var(--bg);color:var(--text);font-size:14px}

/* NOISE OVERLAY */
body::after{content:'';position:fixed;inset:0;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E");pointer-events:none;z-index:999;opacity:.4}

/* GLOW */
body::before{content:'';position:fixed;top:-20%;right:-10%;width:500px;height:500px;background:radial-gradient(circle,rgba(232,0,111,.06) 0%,transparent 70%);pointer-events:none;z-index:0}

/* LAYOUT */
#app{display:flex;height:100vh;position:relative;z-index:1}

/* SIDEBAR */
#sb{width:220px;min-width:220px;background:var(--s1);border-right:1px solid var(--border);display:flex;flex-direction:column;transition:transform .25s cubic-bezier(.4,0,.2,1)}
.sb-logo{padding:20px 16px 14px;border-bottom:1px solid var(--border)}
.sb-logo h1{font-family:'Space Mono',monospace;font-size:1rem;font-weight:700;letter-spacing:.08em;color:var(--white)}
.sb-logo h1 span{color:var(--mg)}
.sb-logo p{font-size:.62rem;color:var(--dim);letter-spacing:.12em;text-transform:uppercase;margin-top:3px}

.sb-nav{padding:12px 8px;flex:0 0 auto}
.sb-sec{font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);padding:8px 8px 4px}

.nb{display:flex;align-items:center;gap:9px;width:100%;padding:8px 10px;border-radius:7px;border:none;background:none;color:var(--sub);font-family:'Space Grotesk',sans-serif;font-size:.8rem;font-weight:400;cursor:pointer;transition:all .15s;text-align:left;letter-spacing:.01em}
.nb:hover{color:var(--text);background:var(--s2)}
.nb.on{color:var(--mg2);background:var(--mgs)}
.nb .ic{width:16px;text-align:center;opacity:.5;font-size:.85rem}
.nb.on .ic{opacity:1}

/* CLIENT LIST */
.cl-area{flex:1;overflow-y:auto;padding:8px;border-top:1px solid var(--border)}
.cl-lbl{font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:var(--dim);padding:6px 4px 6px}
.cp{display:flex;align-items:center;gap:8px;padding:7px 8px;border-radius:7px;cursor:pointer;transition:all .15s;border:1px solid transparent}
.cp:hover{background:var(--s2)}
.cp.on{background:var(--mgs);border-color:rgba(232,0,111,.2)}
.ca{width:26px;height:26px;border-radius:6px;display:flex;align-items:center;justify-content:center;font-family:'Space Mono',monospace;font-size:.65rem;font-weight:700;flex-shrink:0}
.ci{flex:1;min-width:0}
.ci .cn{font-size:.78rem;font-weight:500;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ci .ck{font-size:.65rem;color:var(--dim)}
.cp-edit{background:none;border:none;color:var(--dim);cursor:pointer;font-size:.75rem;padding:2px 4px;border-radius:4px;transition:color .15s;flex-shrink:0}
.cp-edit:hover{color:var(--sub)}
.add-cl{display:flex;align-items:center;gap:7px;width:100%;padding:7px 8px;border:1px dashed var(--border2);border-radius:7px;background:none;color:var(--dim);font-family:'Space Grotesk',sans-serif;font-size:.75rem;cursor:pointer;transition:all .15s;margin-top:4px}
.add-cl:hover{border-color:var(--mg);color:var(--mg)}

/* TOPBAR */
#tb{display:flex;align-items:center;gap:12px;padding:12px 20px;border-bottom:1px solid var(--border);background:var(--s1);flex-shrink:0}
.menu-tog{display:none;background:none;border:none;color:var(--sub);font-size:1.1rem;cursor:pointer;padding:4px}
.tb-badge{display:flex;align-items:center;gap:7px;background:var(--s2);border:1px solid var(--border);border-radius:6px;padding:5px 10px}
.tb-dot{width:6px;height:6px;border-radius:50%}
.tb-badge span{font-size:.75rem;font-weight:500}
.tb-title{flex:1;font-family:'Space Mono',monospace;font-size:.78rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--sub)}
.tb-actions{display:flex;gap:6px}

/* MAIN */
#main{flex:1;display:flex;flex-direction:column;overflow:hidden}
.page{display:none;flex:1;overflow-y:auto;padding:20px;flex-direction:column;gap:16px}
.page.on{display:flex}

/* CARDS */
.card{background:var(--s1);border:1px solid var(--border);border-radius:10px;padding:18px}
.card-t{font-family:'Space Mono',monospace;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--sub);margin-bottom:14px;display:flex;align-items:center;gap:8px}
.card-t .ct-ic{opacity:.3;font-size:.9rem}

/* FORMS */
label{font-size:.7rem;letter-spacing:.06em;text-transform:uppercase;color:var(--dim);display:block;margin-bottom:5px}
select,textarea,input[type=text],input[type=url],input[type=password]{width:100%;background:var(--s2);border:1px solid var(--border);border-radius:7px;color:var(--text);font-family:'Space Grotesk',sans-serif;font-size:.82rem;padding:9px 11px;outline:none;transition:border-color .15s;-webkit-appearance:none;appearance:none}
select:focus,textarea:focus,input:focus{border-color:var(--mg)}
textarea{resize:vertical;min-height:80px;line-height:1.6}
.fr{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.fg{display:flex;flex-direction:column;gap:5px}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:6px;padding:9px 16px;border-radius:7px;border:none;font-family:'Space Grotesk',sans-serif;font-size:.8rem;font-weight:500;cursor:pointer;transition:all .15s;letter-spacing:.02em}
.btn-p{background:var(--mg);color:#fff}
.btn-p:hover{background:var(--mg2);transform:translateY(-1px)}
.btn-p:disabled{opacity:.4;cursor:not-allowed;transform:none}
.btn-g{background:var(--s2);color:var(--sub);border:1px solid var(--border)}
.btn-g:hover{border-color:var(--mg);color:var(--mg2)}
.btn-sm{padding:6px 11px;font-size:.72rem}

/* OUTPUT */
.out-wrap{position:relative;margin-top:12px}
.out-box{background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:14px;font-size:.82rem;line-height:1.8;white-space:pre-wrap;min-height:80px;display:none}
.out-box.vis{display:block}

/* APPROVAL PANEL */
.approval-panel{background:var(--s1);border:1px solid var(--border);border-radius:10px;overflow:hidden;display:none}
.approval-panel.vis{display:block}
.ap-header{padding:12px 16px;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between}
.ap-title{font-family:'Space Mono',monospace;font-size:.68rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--mg)}
.ap-actions{display:flex;gap:6px}
.ap-content{padding:16px;font-size:.82rem;line-height:1.8;white-space:pre-wrap;max-height:400px;overflow-y:auto}
.ap-footer{padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px;align-items:flex-end}
.ap-feedback{flex:1}
.ap-feedback textarea{min-height:50px;font-size:.78rem}

/* COPY BTN */
.cbtn{position:absolute;top:7px;right:7px;background:var(--s1);border:1px solid var(--border);border-radius:5px;color:var(--dim);font-size:.68rem;padding:3px 7px;cursor:pointer;transition:all .15s;font-family:'Space Grotesk',sans-serif}
.cbtn:hover{color:var(--text);border-color:var(--mg)}

/* TYPING */
.typing{display:flex;gap:4px;align-items:center;padding:6px 0}
.typing span{width:5px;height:5px;border-radius:50%;background:var(--mg);animation:bop 1.2s infinite}
.typing span:nth-child(2){animation-delay:.2s}
.typing span:nth-child(3){animation-delay:.4s}
@keyframes bop{0%,60%,100%{transform:translateY(0);opacity:.3}30%{transform:translateY(-5px);opacity:1}}

/* TABS */
.tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:16px;overflow-x:auto}
.tabs::-webkit-scrollbar{display:none}
.tb-btn{padding:8px 14px;background:none;border:none;border-bottom:2px solid transparent;color:var(--dim);font-family:'Space Grotesk',sans-serif;font-size:.75rem;font-weight:500;cursor:pointer;transition:all .15s;white-space:nowrap;letter-spacing:.03em;margin-bottom:-1px}
.tb-btn:hover{color:var(--sub)}
.tb-btn.on{color:var(--mg2);border-bottom-color:var(--mg)}
.tp{display:none}
.tp.on{display:block}

/* CALENDAR */
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:3px}
.cal-hd{text-align:center;font-family:'Space Mono',monospace;font-size:.58rem;font-weight:700;letter-spacing:.08em;color:var(--dim);padding:4px;text-transform:uppercase}
.cal-d{border-radius:6px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;padding:4px 2px;font-size:.72rem;cursor:pointer;transition:all .12s;border:1px solid transparent;min-height:38px;background:var(--s2)}
.cal-d:hover{background:var(--s3)}
.cal-d.hp{border-color:rgba(232,0,111,.3);background:var(--mgs)}
.cal-d.td{border-color:var(--mg)}
.cal-d .dn{font-weight:600;font-family:'Space Mono',monospace;font-size:.7rem}
.cal-d .dots{display:flex;gap:2px;flex-wrap:wrap;justify-content:center;margin-top:2px}
.dot{width:4px;height:4px;border-radius:50%}

/* SCHEDULE */
.sr{display:flex;align-items:center;gap:10px;padding:9px 0;border-bottom:1px solid var(--border)}
.sr:last-child{border-bottom:none}
.st{font-family:'Space Mono',monospace;font-size:.72rem;font-weight:700;color:var(--mg);min-width:44px}
.sc{flex:1;font-size:.78rem;color:var(--sub)}
.ss{width:6px;height:6px;border-radius:50%;flex-shrink:0}

/* STRATEGY GRID */
.sg{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:10px}
.sc-card{background:var(--s2);border:1px solid var(--border);border-radius:9px;padding:14px;cursor:pointer;transition:all .15s}
.sc-card:hover{border-color:rgba(232,0,111,.3);transform:translateY(-2px)}
.sc-ic{font-size:1.2rem;opacity:.25;margin-bottom:8px}
.sc-title{font-family:'Space Mono',monospace;font-size:.72rem;font-weight:700;letter-spacing:.04em;margin-bottom:4px;text-transform:uppercase}
.sc-desc{font-size:.72rem;color:var(--dim);line-height:1.5}

/* TAGS */
.tag{display:inline-block;padding:2px 7px;border-radius:4px;font-size:.62rem;font-weight:600;letter-spacing:.04em;text-transform:uppercase;font-family:'Space Mono',monospace}
.tag-mg{background:var(--mgs);color:var(--mg2);border:1px solid rgba(232,0,111,.2)}
.tag-g{background:rgba(255,255,255,.04);color:var(--sub);border:1px solid var(--border)}

/* MODAL */
.mo{display:none;position:fixed;inset:0;z-index:200;background:rgba(0,0,0,.8);backdrop-filter:blur(6px);align-items:center;justify-content:center;padding:16px}
.mo.on{display:flex}
.md{background:var(--s1);border:1px solid var(--border2);border-radius:12px;padding:24px;width:100%;max-width:480px;max-height:92vh;overflow-y:auto;animation:mdin .18s ease}
@keyframes mdin{from{transform:scale(.96) translateY(8px);opacity:0}to{transform:scale(1) translateY(0);opacity:1}}
.md-title{font-family:'Space Mono',monospace;font-size:.85rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;margin-bottom:20px;color:var(--white)}
.md-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:18px}

/* TONE CHIPS */
.tcs{display:flex;gap:5px;flex-wrap:wrap}
.tc{padding:5px 11px;border-radius:5px;border:1px solid var(--border);background:none;color:var(--dim);font-family:'Space Grotesk',sans-serif;font-size:.72rem;cursor:pointer;transition:all .12s}
.tc.on{border-color:var(--mg);color:var(--mg2);background:var(--mgs)}

/* COLOR ROW */
.crow{display:flex;gap:7px;flex-wrap:wrap}
.csw{width:26px;height:26px;border-radius:5px;cursor:pointer;border:2px solid transparent;transition:all .12s}
.csw.on{border-color:var(--white);transform:scale(1.15)}

/* REVIEW ITEMS */
.ri{display:flex;gap:9px;padding:10px;background:var(--s2);border-radius:7px;border-left:2px solid var(--mg);margin-bottom:7px;font-size:.78rem;line-height:1.5}
.ri.w{border-left-color:#f59e0b}
.ri.ok{border-left-color:#10b981}

/* DESIGN GALLERY */
.dg{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
.di{border-radius:8px;overflow:hidden;background:var(--s2);border:1px solid var(--border);position:relative;cursor:pointer;transition:all .15s}
.di:hover{border-color:rgba(232,0,111,.4)}
.di img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.di-actions{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,.85));padding:18px 6px 6px;display:flex;gap:4px;opacity:0;transition:opacity .15s}
.di:hover .di-actions{opacity:1}
.dia{flex:1;padding:4px;border-radius:4px;background:rgba(255,255,255,.12);border:none;color:#fff;font-size:.65rem;cursor:pointer;font-family:'Space Grotesk',sans-serif}
.dia:hover{background:rgba(255,255,255,.25)}

/* PROGRESS */
.prog-bar{height:2px;background:var(--border);border-radius:1px;overflow:hidden;margin-top:6px}
.prog-fill{height:100%;background:linear-gradient(90deg,var(--mg),var(--mg2));border-radius:1px;transition:width .3s}

/* TASK STATUS */
.tsb{display:flex;align-items:center;gap:10px;background:var(--s2);border:1px solid var(--border);border-radius:8px;padding:11px 13px;font-size:.78rem}
.sp{width:14px;height:14px;border:1.5px solid var(--border2);border-top-color:var(--mg);border-radius:50%;animation:spin .6s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}

/* STOCK GRID */
.stg{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:6px}
.sti{border-radius:7px;overflow:hidden;border:1px solid var(--border);cursor:pointer;transition:all .15s}
.sti:hover{border-color:rgba(232,0,111,.3)}
.sti img{width:100%;aspect-ratio:1;object-fit:cover;display:block}
.sti-m{padding:5px;font-size:.62rem;color:var(--dim)}

/* SCROLLBAR */
::-webkit-scrollbar{width:3px;height:3px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border2);border-radius:2px}

/* MOBILE */
@media(max-width:768px){
  #sb{position:fixed;top:0;left:0;bottom:0;z-index:100;transform:translateX(-100%)}
  #sb.on{transform:translateX(0)}
  .sb-ov{display:none;position:fixed;inset:0;z-index:99;background:rgba(0,0,0,.6)}
  .sb-ov.on{display:block}
  .menu-tog{display:block}
  .fr{grid-template-columns:1fr}
  .page{padding:14px}
}

/* UPLOAD ZONES */
.upload-zone{border:1px dashed var(--border2);border-radius:8px;padding:16px;text-align:center;cursor:pointer;transition:all .15s;background:var(--s2)}
.upload-zone:hover{border-color:var(--mg);background:var(--mgs)}
.pal-chip{width:30px;height:30px;border-radius:6px;cursor:pointer;border:1px solid var(--border2);position:relative;transition:transform .12s}
.pal-chip:hover{transform:scale(1.1)}
.pal-chip::after{content:'×';position:absolute;top:-4px;right:-4px;width:14px;height:14px;background:var(--s1);border:1px solid var(--border2);border-radius:50%;font-size:.6rem;display:flex;align-items:center;justify-content:center;color:var(--sub);opacity:0;transition:opacity .12s}
.pal-chip:hover::after{opacity:1}
.asset-thumb{width:44px;height:44px;border-radius:6px;object-fit:cover;border:1px solid var(--border);position:relative;cursor:pointer}
.brand-bar{display:flex;align-items:center;gap:10px;padding:10px 12px;background:var(--s2);border:1px solid var(--border);border-radius:8px;margin-bottom:12px}
.brand-logo{width:40px;height:40px;border-radius:7px;object-fit:contain;background:var(--s3);padding:3px;flex-shrink:0}
.brand-pal{display:flex;gap:3px}
.brand-pal-dot{width:14px;height:14px;border-radius:3px}

/* UTILS */
.mt8{margin-top:8px}
.mt12{margin-top:12px}
.row{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.sep{height:1px;background:var(--border);margin:4px 0}
</style>
</head>
<body>
<div id="sb-ov" class="sb-ov" onclick="closeSB()"></div>
<div id="app">

<!-- SIDEBAR -->
<aside id="sb">
  <div class="sb-logo">
    <h1>Content<span>OS</span></h1>
    <p>Agente de Produção</p>
  </div>
  <div class="sb-nav">
    <div class="sb-sec">Menu</div>
    <button class="nb on" id="nav-dash" onclick="go('dash')"><span class="ic">◈</span> Dashboard</button>
    <button class="nb" id="nav-gen" onclick="go('gen')"><span class="ic">◎</span> Conteúdo</button>
    <button class="nb" id="nav-design" onclick="go('design')"><span class="ic">◻</span> Design Studio</button>
    <button class="nb" id="nav-cal" onclick="go('cal')"><span class="ic">▦</span> Calendário</button>
    <button class="nb" id="nav-strat" onclick="go('strat')"><span class="ic">◇</span> Estratégia</button>
    <button class="nb" id="nav-rev" onclick="go('rev')"><span class="ic">◉</span> Revisar Post</button>
    <button class="nb" id="nav-sched" onclick="go('sched')"><span class="ic">◷</span> Programação</button>
  </div>
  <div class="cl-area">
    <div class="cl-lbl">Clientes</div>
    <div id="cl-list"></div>
    <button class="add-cl" onclick="openCM()"><span>+</span> Novo cliente</button>
  </div>
</aside>

<!-- MAIN -->
<div id="main">
  <div id="tb">
    <button class="menu-tog" onclick="toggleSB()">≡</button>
    <div class="tb-badge" id="tb-badge">
      <div class="tb-dot" id="tb-dot" style="background:var(--mg)"></div>
      <span id="tb-name">Eu Mesmo</span>
    </div>
    <div class="tb-title" id="tb-title">Dashboard</div>
  </div>

  <!-- DASHBOARD -->
  <div class="page on" id="page-dash">
    <div class="sg">
      <div class="sc-card" onclick="go('gen')"><div class="sc-ic">◎</div><div class="sc-title">Conteúdo</div><div class="sc-desc">Roteiros, copys, legendas e hashtags com IA</div></div>
      <div class="sc-card" onclick="go('design')"><div class="sc-ic">◻</div><div class="sc-title">Design Studio</div><div class="sc-desc">Artes, motion e upscale via Freepik + DALL-E</div></div>
      <div class="sc-card" onclick="go('cal')"><div class="sc-ic">▦</div><div class="sc-title">Calendário</div><div class="sc-desc">Planejamento editorial por cliente</div></div>
      <div class="sc-card" onclick="go('strat')"><div class="sc-ic">◇</div><div class="sc-title">Estratégia</div><div class="sc-desc">Diagnóstico e plano de ação completo</div></div>
      <div class="sc-card" onclick="go('rev')"><div class="sc-ic">◉</div><div class="sc-title">Revisar Post</div><div class="sc-desc">Nota, melhorias e melhor horário</div></div>
      <div class="sc-card" onclick="go('sched')"><div class="sc-ic">◷</div><div class="sc-title">Programação</div><div class="sc-desc">Agenda da semana + integrações</div></div>
    </div>
    <div class="card">
      <div class="card-t"><span class="ct-ic">▦</span> Próximos Posts</div>
      <div id="dash-sched" style="color:var(--dim);font-size:.78rem">Nenhum post programado. Acesse o Calendário para planejar.</div>
    </div>
    <div class="card">
      <div class="card-t"><span class="ct-ic">◈</span> Clientes Ativos</div>
      <div id="dash-clients" style="color:var(--dim);font-size:.78rem">Nenhum cliente cadastrado.</div>
    </div>
  </div>

  <!-- CONTEÚDO -->
  <div class="page" id="page-gen">
    <div class="card">
      <div class="card-t"><span class="ct-ic">◎</span> Gerar Conteúdo</div>
      <div class="tabs" id="gen-tabs">
        <button class="tb-btn on" data-tab="gc-copy" onclick="switchTab('gen-tabs','gc-panels',this,'gc-copy')">Copy / Legenda</button>
        <button class="tb-btn" data-tab="gc-rot" onclick="switchTab('gen-tabs','gc-panels',this,'gc-rot')">Roteiro de Vídeo</button>
        <button class="tb-btn" data-tab="gc-viral" onclick="switchTab('gen-tabs','gc-panels',this,'gc-viral')">Ideia Viral</button>
        <button class="tb-btn" data-tab="gc-hash" onclick="switchTab('gen-tabs','gc-panels',this,'gc-hash')">Hashtags</button>
      </div>
      <div id="gc-panels">
        <!-- COPY -->
