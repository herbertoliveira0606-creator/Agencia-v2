  if (panel) { panel.classList.add('vis'); panel.scrollIntoView({behavior:'smooth', block:'nearest'}); }
  if (textEl) textEl.textContent = text;
}

function hideAP(type) {
  const panel = document.getElementById('ap-' + type);
  if (panel) panel.classList.remove('vis');
}

async function refineContent(type) {
  const fbEl = document.getElementById('ap-' + type + '-fb');
  const fb = fbEl ? fbEl.value.trim() : '';
  const prev = S.pendingContent[type] || '';
  if (!prev) return;
  const c = getC();
  const sys = `Você é especialista em marketing digital. Responda em português. ${ctx(c)}`;
  const prompt = `Refine este conteúdo:\n\n"${prev}"\n\n${fb ? 'Ajuste: ' + fb : 'Melhore de forma geral, deixando mais impactante e alinhado ao perfil do cliente.'}`;
  const textEl = document.getElementById('ap-' + type + '-text');
  if (textEl) textEl.innerHTML = '<div class="typing"><span></span><span></span><span></span></div>';
  try {
    const r = await claude(prompt, sys);
    S.pendingContent[type] = r;
    if (textEl) textEl.textContent = r;
    if (fbEl) fbEl.value = '';
  } catch(e) { if (textEl) textEl.textContent = 'Erro: ' + e.message; }
}

function approveContent(type) {
  const text = S.pendingContent[type];
  if (!text) return;
  navigator.clipboard.writeText(text).catch(()=>{});
  const c = getC();
  S.approved.unshift({ id: Date.now(), type, text, client: c.name, ts: new Date().toLocaleDateString('pt-BR') });
  persist();
  renderApproved();
  hideAP(type);
  // Show approved card
  document.getElementById('approved-card').style.display = 'block';
  alert('✓ Conteúdo aprovado e copiado!');
}

function renderApproved() {
  const el = document.getElementById('approved-list');
