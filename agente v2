function renderCal() {
  const months = ['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
  document.getElementById('cal-lbl').textContent = `${months[S.month]} ${S.year}`;
  const days = ['Dom','Seg','Ter','Qua','Qui','Sex','Sáb'];
  let h = days.map(d=>`<div class="cal-hd">${d}</div>`).join('');
  const first = new Date(S.year, S.month, 1).getDay();
  const total = new Date(S.year, S.month+1, 0).getDate();
  const today = new Date();
  for(let i=0;i<first;i++) h+='<div></div>';
  for(let d=1;d<=total;d++) {
    const ds = `${String(d).padStart(2,'0')}/${String(S.month+1).padStart(2,'0')}/${S.year}`;
    const ps = S.posts.filter(p=>p.date===ds);
    const isT = today.getDate()===d && today.getMonth()===S.month && today.getFullYear()===S.year;
    h+=`<div class="cal-d ${ps.length?'hp':''} ${isT?'td':''}">
      <span class="dn">${d}</span>
      ${ps.length?`<div class="dots">${ps.slice(0,3).map(p=>`<div class="dot" style="background:${p.color||'var(--mg)'}"></div>`).join('')}</div>`:''}
    </div>`;
  }
  document.getElementById('cal-grid').innerHTML = h;
  renderCalPosts();
}
